<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Зіркова Вікторина — Масова частка розчиненої речовини</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Montserrat', sans-serif;
      background: radial-gradient(circle at center, #0f172a 0%, #090d16 60%, #030509 100%);
      color: #ffffff;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Studio Light Beams */
    .spotlight {
      position: absolute;
      top: -20%;
      width: 200px;
      height: 140%;
      background: linear-gradient(180deg, rgba(59, 130, 246, 0.15) 0%, rgba(147, 51, 234, 0.08) 50%, transparent 100%);
      transform-origin: top center;
      filter: blur(20px);
      pointer-events: none;
    }
    .spotlight-1 { left: 10%; transform: rotate(22deg); animation: swing1 8s ease-in-out infinite alternate; }
    .spotlight-2 { right: 10%; transform: rotate(-22deg); animation: swing2 9s ease-in-out infinite alternate; }

    @keyframes swing1 {
      0% { transform: rotate(18deg); }
      100% { transform: rotate(30deg); }
    }
    @keyframes swing2 {
      0% { transform: rotate(-18deg); }
      100% { transform: rotate(-30deg); }
    }

    /* Custom Option Buttons */
    .btn-option {
      background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
      border: 2px solid #3b82f6;
      box-shadow: 0 0 15px rgba(59, 130, 246, 0.2), inset 0 0 10px rgba(59, 130, 246, 0.1);
      transition: all 0.2s ease;
    }

    .btn-option:hover:not(:disabled) {
      background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
      border-color: #60a5fa;
      box-shadow: 0 0 25px rgba(96, 165, 250, 0.5);
      transform: translateY(-2px);
    }

    .btn-option.correct {
      background: linear-gradient(180deg, #059669 0%, #047857 100%) !important;
      border-color: #34d399 !important;
      box-shadow: 0 0 35px rgba(52, 211, 153, 0.9) !important;
      color: #fff !important;
    }

    .btn-option.wrong {
      background: linear-gradient(180deg, #dc2626 0%, #b91c1c 100%) !important;
      border-color: #f87171 !important;
      box-shadow: 0 0 30px rgba(248, 113, 113, 0.8) !important;
    }

    .glow-gold { text-shadow: 0 0 16px rgba(245, 158, 11, 0.8); }
    .glow-cyan { text-shadow: 0 0 14px rgba(6, 182, 212, 0.7); }
  </style>
</head>
<body class="flex flex-col min-h-screen relative overflow-x-hidden selection:bg-amber-500 selection:text-black">
  
  <div class="spotlight spotlight-1"></div>
  <div class="spotlight spotlight-2"></div>

  <!-- Header -->
  <header class="w-full bg-slate-900/90 backdrop-blur border-b border-blue-900/60 py-4 px-6 md:px-10 flex items-center justify-between z-20 relative">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-500 to-yellow-300 flex items-center justify-center font-black text-slate-950 text-xl shadow-lg shadow-amber-500/30">
        ⭐
      </div>
      <div>
        <h1 class="text-base md:text-xl font-black tracking-wide text-white">Зіркова Вікторина</h1>
        <p class="text-xs text-amber-400 font-medium">Тема: Масова частка розчиненої речовини</p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <button onclick="finishGameEarly()" class="px-3.5 py-2 rounded-xl bg-red-950/60 border border-red-800 hover:bg-red-900 text-red-200 text-sm font-semibold transition flex items-center gap-1.5 shadow-lg">
        🏁 <span>Завершити</span>
      </button>
    </div>
  </header>

  <!-- START SCREEN -->
  <div id="startScreen" class="flex-1 flex flex-col items-center justify-center p-6 text-center z-20 max-w-4xl mx-auto my-auto">
    <div class="relative mb-6">
      <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-gradient-to-tr from-amber-400 via-purple-600 to-blue-500 p-1 shadow-2xl shadow-blue-500/30">
        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80" alt="Ведуча" class="w-full h-full rounded-full object-cover">
      </div>
    </div>

    <h2 class="text-3xl md:text-5xl font-black text-white mb-3 glow-gold">Масова частка розчиненої речовини</h2>
    <p class="text-amber-300 text-base md:text-xl mb-8 max-w-xl font-medium">Перевір свої знання: 12 запитань із крупним текстом та поясненнями!</p>

    <button onclick="startGame()" class="px-12 py-5 rounded-2xl bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-400 text-slate-950 font-black text-xl uppercase tracking-wider shadow-2xl shadow-amber-500/40 hover:scale-105 active:scale-95 transition transform">
      Start the challenge 🚀
    </button>
  </div>

  <!-- MAIN GAME INTERFACE -->
  <main id="gameScreen" class="hidden flex-1 max-w-5xl w-full mx-auto p-4 md:p-6 flex flex-col justify-between gap-6 z-10">

    <!-- Top Status Bar -->
    <div class="bg-slate-900/90 border border-blue-900/70 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4 backdrop-blur shadow-2xl">
      <div class="flex items-center gap-4">
        <div class="relative w-12 h-12 flex items-center justify-center shrink-0">
          <svg class="timer-svg w-full h-full transform -rotate-90" viewBox="0 0 36 36">
            <path class="text-slate-800" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            <path id="timerProgress" class="text-amber-400" stroke-dasharray="100, 100" stroke-dashoffset="0" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
          </svg>
          <span id="timerText" class="absolute font-black text-sm text-amber-300">30</span>
        </div>
        <div>
          <div id="levelCategory" class="text-xs uppercase tracking-wider text-slate-400 font-bold">Рівень 1 з 12</div>
          <div id="currentPrizeHeader" class="text-lg md:text-xl font-black text-amber-300 glow-gold">Зірки: 0 ⭐</div>
        </div>
      </div>

      <!-- Lifelines -->
      <div class="flex items-center gap-2">
        <button id="lifeline5050" onclick="use5050()" class="px-3.5 py-2 rounded-xl bg-slate-800 border-2 border-amber-500/60 hover:border-amber-400 text-amber-300 font-black text-xs md:text-sm shadow-md transition disabled:opacity-30">
          50:50
        </button>
        <button id="lifelineClue" onclick="useClue()" class="px-3.5 py-2 rounded-xl bg-slate-800 border-2 border-cyan-500/60 hover:border-cyan-400 text-cyan-300 font-bold text-xs md:text-sm shadow-md transition disabled:opacity-30">
          💡 Підказка
        </button>
      </div>
    </div>

    <!-- Host Dialogue Box -->
    <div class="bg-slate-900/90 border border-blue-800/60 rounded-2xl p-4 flex items-center gap-4 backdrop-blur shadow-lg">
      <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-gradient-to-tr from-purple-600 to-blue-500 p-0.5 shrink-0 shadow-lg">
        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=200&q=80" alt="Ведуча" class="w-full h-full rounded-full object-cover">
      </div>
      <div class="flex-1">
        <div class="text-xs font-extrabold text-purple-400 uppercase tracking-wide">Ведуча програми</div>
        <p id="hostSpeech" class="text-sm md:text-base text-slate-200 font-medium italic mt-0.5">
          "Уважно прочитайте запитання та оберіть правильний варіант."
        </p>
      </div>
    </div>

    <!-- Question Box (Large Text) -->
    <div class="bg-gradient-to-b from-slate-900/95 to-blue-950/90 border-2 border-blue-600/70 rounded-3xl p-6 md:p-10 shadow-2xl backdrop-blur relative flex-1 flex flex-col justify-center min-h-[180px]">
      <h2 id="questionText" class="text-xl md:text-3xl font-extrabold text-white leading-relaxed text-center glow-cyan">
        Завантаження запитання...
      </h2>
    </div>

    <!-- Answers Grid (Large, Readable Text) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-2">
      <button id="opt-0" onclick="selectOption(0)" class="btn-option rounded-2xl p-5 text-left flex items-center gap-4 text-slate-100 font-bold text-base md:text-lg transition-all">
        <span class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/40 font-black flex items-center justify-center text-base shrink-0">А</span>
        <span id="opt-text-0" class="flex-1 leading-snug">...</span>
      </button>

      <button id="opt-1" onclick="selectOption(1)" class="btn-option rounded-2xl p-5 text-left flex items-center gap-4 text-slate-100 font-bold text-base md:text-lg transition-all">
        <span class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/40 font-black flex items-center justify-center text-base shrink-0">Б</span>
        <span id="opt-text-1" class="flex-1 leading-snug">...</span>
      </button>

      <button id="opt-2" onclick="selectOption(2)" class="btn-option rounded-2xl p-5 text-left flex items-center gap-4 text-slate-100 font-bold text-base md:text-lg transition-all">
        <span class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/40 font-black flex items-center justify-center text-base shrink-0">В</span>
        <span id="opt-text-2" class="flex-1 leading-snug">...</span>
      </button>

      <button id="opt-3" onclick="selectOption(3)" class="btn-option rounded-2xl p-5 text-left flex items-center gap-4 text-slate-100 font-bold text-base md:text-lg transition-all">
        <span class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/40 font-black flex items-center justify-center text-base shrink-0">Г</span>
        <span id="opt-text-3" class="flex-1 leading-snug">...</span>
      </button>
    </div>

  </main>

  <!-- Explanation Modal (Shows after ANY answer with Smiley) -->
  <div id="modalExplanation" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border-2 border-blue-500 rounded-3xl max-w-lg w-full p-8 shadow-2xl relative overflow-hidden text-center">
      <div id="modalHeaderBg" class="h-2 w-full absolute top-0 left-0 bg-emerald-500"></div>
      
      <!-- Смайлик -->
      <div id="modalEmoji" class="text-6xl mb-3">😊</div>
      
      <h3 id="modalTitle" class="text-2xl font-extrabold text-white mb-3">Правильно!</h3>

      <div id="modalBody" class="bg-slate-950/80 border border-slate-800 rounded-2xl p-5 text-sm md:text-base text-slate-200 leading-relaxed mb-6 text-left">
        <!-- Text explanation -->
      </div>

      <button onclick="proceedToNextQuestion()" class="w-full py-4 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold text-lg shadow-lg hover:from-blue-500 hover:to-indigo-500 transition">
        Продовжити гру ➡️
      </button>
    </div>
  </div>

  <!-- End Game Screen -->
  <div id="modalEndGame" class="fixed inset-0 bg-slate-950/90 backdrop-blur-lg z-50 hidden flex items-center justify-center p-4">
    <div class="bg-gradient-to-b from-slate-900 to-blue-950 border-2 border-amber-500/70 rounded-3xl max-w-md w-full p-8 text-center shadow-2xl relative overflow-hidden">
      <div class="text-6xl mb-4">🏆</div>
      <h2 class="text-3xl font-black text-amber-300 mb-2 glow-gold">Вітаємо!</h2>
      <p class="text-slate-300 text-base mb-6">Вікторину завершено!</p>

      <div class="bg-slate-950/80 border border-amber-500/30 rounded-2xl p-5 mb-6">
        <div class="text-xs text-slate-400 uppercase tracking-widest mb-1">Зароблено зірок:</div>
        <div id="endPrizeAmount" class="text-4xl font-black text-amber-400">0 ⭐</div>
      </div>

      <button onclick="restartGame()" class="w-full py-4 rounded-2xl bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 text-slate-950 font-black text-lg uppercase tracking-wider shadow-xl hover:scale-105 active:scale-95 transition">
        Зіграти ще раз 🔄
      </button>
    </div>
  </div>

  <script>
    const QUESTIONS = [
      {
        level: 1, prize: 10,
        question: "Що таке масова частка розчиненої речовини?",
        options: [
          "Відношення об'єму речовини до об'єму розчину",
          "Відношення маси розчиненої речовини до маси розчину",
          "Відношення маси розчиненої речовини до маси води",
          "Добуток маси речовини на масу розчину"
        ],
        correct: 1,
        explanation: "Масова частка (w) — це відношення маси розчиненої речовини до загальної маси всього розчину.",
        hint: "Це відношення маси речовини до маси всього розчину."
      },
      {
        level: 2, prize: 20,
        question: "У яких одиницях найчастіше виражають масову частку?",
        options: [
          "У молях на літр",
          "У частках від одиниці або відсотках",
          "У мілілітрах",
          "У грамах або кілограмах"
        ],
        correct: 1,
        explanation: "Масову частку виражають у частках від одиниці (наприклад, 0.1) або у відсотках (%).",
        hint: "Згадайте знак відсотка (%) або десяткові дроби."
      },
      {
        level: 3, prize: 30,
        question: "Обчисліть масу розчину, якщо він складається з 10 г солі та 90 г води.",
        options: ["100 г", "80 г", "110 г", "90 г"],
        correct: 0,
        explanation: "Маса розчину = маса солі + маса води = 10 г + 90 г = 100 г.",
        hint: "Додайте масу солі до маси води."
      },
      {
        level: 4, prize: 40,
        question: "Яка масова частка солі в розчині, де 20 г солі розчинено у 180 г води?",
        options: ["10%", "5%", "11.1%", "20%"],
        correct: 0,
        explanation: "Маса розчину = 20 + 180 = 200 г. Частка = 20 / 200 = 0.1 або 10%.",
        hint: "Поділіть 20 г на загальну масу розчину (200 г)."
      },
      {
        level: 5, prize: 50,
        question: "Як зміниться масова частка речовини, якщо до розчину додати води?",
        options: ["Збільшиться", "Зменшиться", "Не зміниться", "Спочатку збільшиться, потім зменшиться"],
        correct: 1,
        explanation: "При додаванні води загальна маса розчину збільшується, а маса речовини ні, тому частка зменшується.",
        hint: "Розбавлення розчину водою знижує його концентрацію."
      },
      {
        level: 6, prize: 60,
        question: "Скільки солі потрібно взяти для приготування 200 г розчину з масовою часткою 5%?",
        options: ["100 г", "20 г", "10 г", "5 г"],
        correct: 2,
        explanation: "Маса солі = 200 г × 0.05 = 10 г.",
        hint: "Помножте 200 на 0.05."
      },
      {
        level: 7, prize: 70,
        question: "Як називають розчин, у якому масова частка речовини є максимально можливою за даної температури?",
        options: ["Концентрований", "Насичений", "Пересичений", "Розбавлений"],
        correct: 1,
        explanation: "Насичений розчин — це такий розчин, у якому речовина за даної температури більше не розчиняється.",
        hint: "У ньому досягнута межа розчинності."
      },
      {
        level: 8, prize: 80,
        question: "До 150 г розчину з масовою часткою 10% додали 50 г води. Яка нова масова частка?",
        options: ["8%", "5%", "10%", "7.5%"],
        correct: 3,
        explanation: "Маса солі = 15 г. Нова маса розчину = 200 г. Частка = 15 / 200 = 0.075 або 7.5%.",
        hint: "Знайдіть масу чистої солі та поділіть на новий об'єм розчину (200 г)."
      },
      {
        level: 9, prize: 90,
        question: "Фізіологічний розчин — це розчин кухонної солі з масовою часткою:",
        options: ["9%", "0.9%", "5%", "0.1%"],
        correct: 1,
        explanation: "Фізіологічний розчин містить 0.9% NaCl і є безпечним для введення в організм.",
        hint: "Це дуже розбавлений розчин менше одного відсотка."
      },
      {
        level: 10, prize: 100,
        question: "У 300 г розчину міститься 60 г цукру. Яка масова частка цукру?",
        options: ["25%", "10%", "15%", "20%"],
        correct: 3,
        explanation: "60 г / 300 г = 0.2, що дорівнює 20%.",
        hint: "Поділіть 60 на 300."
      },
      {
        level: 11, prize: 110,
        question: "Яка формула використовується для обчислення маси розчину за густиною та об'ємом?",
        options: ["m = V / ρ", "m = V + ρ", "m = V * ρ", "m = ρ / V"],
        correct: 2,
        explanation: "Маса дорівнює добутку об'єму на густину: m = V * ρ.",
        hint: "Добуток об'єму та густини дає масу."
      },
      {
        level: 12, prize: 120,
        question: "Яку масу цукру треба додати до 100 г розчину з часткою 10%, щоб вона стала 20%?",
        options: ["20 г", "10 г", "15 г", "12.5 г"],
        correct: 3,
        explanation: "Початково цукру 10 г. Після додавання 12.5 г цукру: (10 + 12.5) / (100 + 12.5) = 22.5 / 112.5 = 20%.",
        hint: "Рівняння дає результат 12.5 грамів."
      }
    ];

    let currentLevelIndex = 0;
    let score = 0;
    let timerInterval = null;
    let timeLeft = 30;
    let lifelines = { fiftyFifty: true, clue: true };

    function startGame() {
      document.getElementById('startScreen').classList.add('hidden');
      document.getElementById('gameScreen').classList.remove('hidden');
      score = 0;
      currentLevelIndex = 0;
      loadQuestion(0);
    }

    function loadQuestion(index) {
      currentLevelIndex = index;
      if (currentLevelIndex >= QUESTIONS.length) {
        endGame();
        return;
      }

      const q = QUESTIONS[index];
      document.getElementById('levelCategory').innerText = `Рівень ${index + 1} з ${QUESTIONS.length}`;
      document.getElementById('currentPrizeHeader').innerText = `Зірки: ${score} ⭐`;
      document.getElementById('questionText').innerHTML = q.question;
      document.getElementById('hostSpeech').innerText = `Запитання на ${q.prize} зірок. Оберіть правильну відповідь!`;

      for (let i = 0; i < 4; i++) {
        const btn = document.getElementById(`opt-${i}`);
        const textSpan = document.getElementById(`opt-text-${i}`);
        btn.className = 'btn-option rounded-2xl p-5 text-left flex items-center gap-4 text-slate-100 font-bold text-base md:text-lg transition-all';
        btn.disabled = false;
        textSpan.innerHTML = q.options[i];
      }

      startTimer();
    }

    function startTimer() {
      clearInterval(timerInterval);
      timeLeft = 30;
      updateTimerUI();

      timerInterval = setInterval(() => {
        timeLeft--;
        updateTimerUI();
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          handleTimeOut();
        }
      }, 1000);
    }

    function updateTimerUI() {
      document.getElementById('timerText').innerText = timeLeft;
      const offset = 100 - (timeLeft / 30) * 100;
      document.getElementById('timerProgress').style.strokeDashoffset = offset;
    }

    function handleTimeOut() {
      const q = QUESTIONS[currentLevelIndex];
      showExplanation(false, `Час вийшов! Правильна відповідь: <b>${q.options[q.correct]}</b>.<br><br>${q.explanation}`);
    }

    function selectOption(index) {
      clearInterval(timerInterval);
      const q = QUESTIONS[currentLevelIndex];
      const isCorrect = (index === q.correct);
      const selectedBtn = document.getElementById(`opt-${index}`);

      for (let i = 0; i < 4; i++) {
        document.getElementById(`opt-${i}`).disabled = true;
      }

      if (isCorrect) {
        selectedBtn.classList.add('correct');
        score += q.prize;
        document.getElementById('currentPrizeHeader').innerText = `Зірки: ${score} ⭐`;
        showExplanation(true, `Чудово! Абсолютно правильна відповідь.<br><br>${q.explanation}`);
      } else {
        selectedBtn.classList.add('wrong');
        document.getElementById(`opt-${q.correct}`).classList.add('correct');
        showExplanation(false, `На жаль, це помилка. Правильна відповідь: <b>${q.options[q.correct]}</b>.<br><br>${q.explanation}`);
      }
    }

    function showExplanation(isCorrect, text) {
      const modal = document.getElementById('modalExplanation');
      const headerBg = document.getElementById('modalHeaderBg');
      const emoji = document.getElementById('modalEmoji');
      const title = document.getElementById('modalTitle');
      const body = document.getElementById('modalBody');

      body.innerHTML = text;
      if (isCorrect) {
        headerBg.className = 'h-2 w-full absolute top-0 left-0 bg-emerald-500';
        emoji.innerText = '😊'; // Веселий смайлик
        title.innerText = 'Правильно!';
        title.className = 'text-2xl font-extrabold text-emerald-400 mb-3';
      } else {
        headerBg.className = 'h-2 w-full absolute top-0 left-0 bg-red-500';
        emoji.innerText = '😢'; // Сумний смайлик
        title.innerText = 'Неправильно!';
        title.className = 'text-2xl font-extrabold text-red-400 mb-3';
      }
      modal.classList.remove('hidden');
    }

    function proceedToNextQuestion() {
      document.getElementById('modalExplanation').classList.add('hidden');
      currentLevelIndex++;
      loadQuestion(currentLevelIndex);
    }

    function use5050() {
      if (!lifelines.fiftyFifty) return;
      lifelines.fiftyFifty = false;
      document.getElementById('lifeline5050').disabled = true;

      const q = QUESTIONS[currentLevelIndex];
      let wrongIndexes = [0, 1, 2, 3].filter(idx => idx !== q.correct);
      wrongIndexes.sort(() => Math.random() - 0.5);
      
      wrongIndexes.slice(0, 2).forEach(idx => {
        const btn = document.getElementById(`opt-${idx}`);
        btn.disabled = true;
        btn.classList.add('opacity-20');
      });
    }

    function useClue() {
      if (!lifelines.clue) return;
      lifelines.clue = false;
      document.getElementById('lifelineClue').disabled = true;

      const q = QUESTIONS[currentLevelIndex];
      document.getElementById('hostSpeech').innerText = `💡 Підказка: ${q.hint}`;
    }

    function finishGameEarly() {
      clearInterval(timerInterval);
      endGame();
    }

    function endGame() {
      document.getElementById('gameScreen').classList.add('hidden');
      document.getElementById('modalExplanation').classList.add('hidden');
      document.getElementById('modalEndGame').classList.remove('hidden');
      document.getElementById('endPrizeAmount').innerText = `${score} ⭐`;
    }

    function restartGame() {
      document.getElementById('modalEndGame').classList.add('hidden');
      document.getElementById('startScreen').classList.remove('hidden');
      lifelines = { fiftyFifty: true, clue: true };
      document.getElementById('lifeline5050').disabled = false;
      document.getElementById('lifelineClue').disabled = false;
    }
  </script>
</body>
</html>
